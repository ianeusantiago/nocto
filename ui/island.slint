// Nocto — a ilha. O tamanho e a posição da janela são controlados pelo Rust (win.rs);
// aqui só se desenha o conteúdo de cada modo.

export struct DayCell {
    label: string,
    iso: string,
    in-month: bool,
    today: bool,
    selected: bool,
    marked: bool,
}

export struct Item {
    time: string,
    title: string,
    done: bool,
}

// Ícones da fonte "Segoe MDL2 Assets" (Windows 10 e 11).
global Icons {
    out property <string> play: "\u{E768}";
    out property <string> pause: "\u{E769}";
    out property <string> next: "\u{E893}";
    out property <string> search: "\u{E721}";
    out property <string> left: "\u{E76B}";
    out property <string> right: "\u{E76C}";
    out property <string> close: "\u{E711}";
    out property <string> check: "\u{E73E}";
    out property <string> image: "\u{EB9F}";
}

component Glyph inherits Text {
    font-family: "Segoe MDL2 Assets";
    vertical-alignment: center;
    horizontal-alignment: center;
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <color> ink;
    in property <length> size: 13px;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: touch.has-hover ? ink.with-alpha(0.14) : transparent;
    Glyph {
        text: icon;
        color: ink;
        font-size: size;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <color> ink;
    in property <color> accent;
    callback clicked();
    height: 28px;
    border-radius: 14px;
    background: touch.has-hover ? accent.with-alpha(0.35) : ink.with-alpha(0.12);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            color: ink;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component Island inherits Window {
    title: "Nocto";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 14px;
    min-width: 120px;
    min-height: 36px;
    max-width: 4000px;
    max-height: 4000px;

    // 0 pílula, 1 barra de comando, 2 calendário, 3 soltar arquivo
    in property <int> mode: 0;
    in property <color> glass: #0b2a44b3;
    in property <color> accent: #2bb4ff;
    in property <color> ink: #ffffff;

    in property <string> track;
    in property <bool> playing;
    in property <bool> has-track;
    in property <string> notice: "Nocto";

    in property <string> status;
    in property <bool> status-error;

    in property <string> month-label;
    in property <[DayCell]> days;
    in property <[Item]> items;
    in property <string> selected-label;
    in property <string> theme-label;

    in property <string> drop-name;

    callback submit(string);
    callback cancel();
    callback expand();
    callback collapse();
    callback play-pause();
    callback next-track();
    callback prev-month();
    callback next-month();
    callback pick-day(string);
    callback add-item(string);
    callback toggle-item(int);
    callback remove-item(int);
    callback cycle-theme();
    callback convert(string);

    public function focus-input() {
        input.text = "";
        input.focus();
    }

    public function focus-item-input() {
        item-input.focus();
    }

    shell := Rectangle {
        background: root.glass;
        border-radius: root.mode == 0 ? self.height / 2 : 22px;
        border-width: 1px;
        border-color: root.ink.with-alpha(0.18);
        animate background { duration: 3s; easing: ease-in-out; }

        // ───────── Pílula ─────────
        if root.mode == 0: Rectangle {
            TouchArea {
                clicked => { root.expand(); }
            }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 8px;
                spacing: 10px;
                alignment: stretch;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 4px;
                    background: root.playing ? root.accent : root.ink.with-alpha(0.45);
                }
                Text {
                    text: root.has-track ? root.track : root.notice;
                    color: root.ink;
                    font-size: 13px;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if root.has-track: IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: root.playing ? Icons.pause : Icons.play;
                    ink: root.ink;
                    clicked => { root.play-pause(); }
                }
                if root.has-track: IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.next;
                    ink: root.ink;
                    clicked => { root.next-track(); }
                }
            }
        }

        // ───────── Barra de comando ─────────
        bar := FocusScope {
            visible: root.mode == 1;
            enabled: root.mode == 1;
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.cancel();
                    return accept;
                }
                reject
            }
            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 12px;
                    height: 44px;
                    Glyph {
                        text: Icons.search;
                        color: root.ink.with-alpha(0.7);
                        font-size: 16px;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        Text {
                            x: 0;
                            width: parent.width;
                            visible: input.text == "";
                            text: "abre spotify · toca <música> · agenda · pausa";
                            color: root.ink.with-alpha(0.4);
                            font-size: 17px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        input := TextInput {
                            width: parent.width;
                            color: root.ink;
                            selection-background-color: root.accent.with-alpha(0.5);
                            font-size: 17px;
                            vertical-alignment: center;
                            single-line: true;
                            accepted => { root.submit(self.text); }
                        }
                    }
                }
                if root.status != "": Text {
                    text: root.status;
                    color: root.status-error ? #ffb4a8 : root.ink.with-alpha(0.8);
                    font-size: 13px;
                    overflow: elide;
                    height: 26px;
                    vertical-alignment: center;
                }
            }
        }

        // ───────── Calendário ─────────
        cal := FocusScope {
            visible: root.mode == 2;
            enabled: root.mode == 2;
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.collapse();
                    return accept;
                }
                reject
            }
            HorizontalLayout {
                padding: 18px;
                spacing: 18px;

                // Grade do mês
                VerticalLayout {
                    width: 300px;
                    spacing: 6px;
                    HorizontalLayout {
                        height: 30px;
                        Text {
                            text: root.month-label;
                            color: root.ink;
                            font-size: 17px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        IconButton {
                            icon: Icons.left;
                            ink: root.ink;
                            size: 11px;
                            clicked => { root.prev-month(); }
                        }
                        IconButton {
                            icon: Icons.right;
                            ink: root.ink;
                            size: 11px;
                            clicked => { root.next-month(); }
                        }
                    }
                    HorizontalLayout {
                        height: 18px;
                        for w in ["D", "S", "T", "Q", "Q", "S", "S"]: Text {
                            width: 300px / 7;
                            text: w;
                            color: root.ink.with-alpha(0.5);
                            font-size: 11px;
                            horizontal-alignment: center;
                        }
                    }
                    Rectangle {
                        height: 6 * 38px;
                        for d[i] in root.days: Rectangle {
                            x: mod(i, 7) * (300px / 7);
                            y: floor(i / 7) * 38px;
                            width: 300px / 7;
                            height: 38px;
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 16px;
                                background: d.selected ? root.accent : (cell.has-hover ? root.ink.with-alpha(0.12) : transparent);
                                border-width: d.today && !d.selected ? 1px : 0px;
                                border-color: root.accent;
                            }
                            Text {
                                text: d.label;
                                color: d.in-month ? root.ink : root.ink.with-alpha(0.3);
                                font-size: 13px;
                                font-weight: d.today ? 700 : 400;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            if d.marked: Rectangle {
                                y: parent.height - 6px;
                                width: 4px;
                                height: 4px;
                                border-radius: 2px;
                                background: d.selected ? root.ink : root.accent;
                            }
                            cell := TouchArea {
                                clicked => { root.pick-day(d.iso); }
                            }
                        }
                    }
                }

                // Itens do dia
                VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        height: 30px;
                        Text {
                            text: root.selected-label;
                            color: root.ink;
                            font-size: 15px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Chip {
                            text: root.theme-label;
                            ink: root.ink;
                            accent: root.accent;
                            clicked => { root.cycle-theme(); }
                        }
                    }
                    Flickable {
                        vertical-stretch: 1;
                        content-height: max(self.height, root.items.length * 36px);
                        for it[i] in root.items: Rectangle {
                            y: i * 36px;
                            height: 34px;
                            width: parent.width;
                            border-radius: 8px;
                            background: row.has-hover ? root.ink.with-alpha(0.08) : transparent;
                            row := TouchArea {
                                clicked => { root.toggle-item(i); }
                            }
                            HorizontalLayout {
                                padding-left: 6px;
                                spacing: 8px;
                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 9px;
                                    border-width: 1.5px;
                                    border-color: root.accent;
                                    background: it.done ? root.accent : transparent;
                                    if it.done: Glyph {
                                        text: Icons.check;
                                        color: root.glass.with-alpha(1);
                                        font-size: 10px;
                                    }
                                }
                                if it.time != "": Text {
                                    text: it.time;
                                    color: root.accent;
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: it.title;
                                    color: it.done ? root.ink.with-alpha(0.45) : root.ink;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                IconButton {
                                    y: (parent.height - self.height) / 2;
                                    icon: Icons.close;
                                    ink: root.ink.with-alpha(0.6);
                                    size: 10px;
                                    clicked => { root.remove-item(i); }
                                }
                            }
                        }
                        if root.items.length == 0: Text {
                            y: 8px;
                            text: "Nada marcado.";
                            color: root.ink.with-alpha(0.5);
                            font-size: 13px;
                        }
                    }
                    Rectangle {
                        height: 36px;
                        border-radius: 8px;
                        background: root.ink.with-alpha(0.1);
                        Text {
                            x: 12px;
                            visible: item-input.text == "";
                            text: "14:00 reunião · Enter para adicionar";
                            color: root.ink.with-alpha(0.4);
                            font-size: 13px;
                            vertical-alignment: center;
                            height: parent.height;
                        }
                        item-input := TextInput {
                            x: 12px;
                            width: parent.width - 24px;
                            height: parent.height;
                            color: root.ink;
                            font-size: 13px;
                            vertical-alignment: center;
                            single-line: true;
                            accepted => {
                                root.add-item(self.text);
                                self.text = "";
                            }
                        }
                    }
                }
            }
        }

        // ───────── Soltar arquivo ─────────
        if root.mode == 3: FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.collapse();
                    return accept;
                }
                reject
            }
            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 10px;
                    Glyph {
                        text: Icons.image;
                        color: root.accent;
                        font-size: 18px;
                    }
                    Text {
                        text: root.drop-name == "" ? "Solte a imagem aqui" : root.drop-name;
                        color: root.ink;
                        font-size: 15px;
                        font-weight: 600;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    IconButton {
                        icon: Icons.close;
                        ink: root.ink;
                        size: 10px;
                        clicked => { root.collapse(); }
                    }
                }
                if root.drop-name != "": HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Chip { text: "PNG"; ink: root.ink; accent: root.accent; clicked => { root.convert("png"); } }
                    Chip { text: "JPEG"; ink: root.ink; accent: root.accent; clicked => { root.convert("jpeg"); } }
                    Chip { text: "WebP"; ink: root.ink; accent: root.accent; clicked => { root.convert("webp"); } }
                }
                Text {
                    text: root.status;
                    color: root.status-error ? #ffb4a8 : root.ink.with-alpha(0.8);
                    font-size: 12px;
                    overflow: elide;
                }
            }
        }
    }
}
