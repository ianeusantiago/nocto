// Nocto — a ilha. O tamanho e a posição da janela são controlados pelo Rust (win.rs);
// aqui só se desenha o conteúdo de cada modo.

export struct DayCell {
    label: string,
    iso: string,
    in-month: bool,
    today: bool,
    selected: bool,
    marked: bool,
}

export struct WaMsg {
    sender: string,
    text: string,
    time: string,
}

export struct Item {
    time: string,
    title: string,
    done: bool,
}

// Ícones da fonte "Segoe MDL2 Assets" (Windows 10 e 11).
global Icons {
    out property <string> play: "\u{E768}";
    out property <string> pause: "\u{E769}";
    out property <string> next: "\u{E893}";
    out property <string> search: "\u{E721}";
    out property <string> left: "\u{E76B}";
    out property <string> right: "\u{E76C}";
    out property <string> close: "\u{E711}";
    out property <string> check: "\u{E73E}";
    out property <string> image: "\u{EB9F}";
    out property <string> prev: "\u{E892}";
}

// Logo do Spotify: círculo verde com as três ondas pretas (forma oficial, em vetor).
component SpotifyLogo inherits Rectangle {
    in property <length> size: 24px;
    width: size;
    height: size;
    // Fundo preto atrás: as ondas são "furos" no desenho verde.
    Rectangle {
        x: parent.width * 0.08;
        y: parent.height * 0.08;
        width: parent.width * 0.84;
        height: parent.height * 0.84;
        border-radius: self.width / 2;
        background: #000000;
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: #1ed760;
        commands: "M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z";
    }
}

// Knob de volume (estilo FL Studio): anel de luzes que acende até o valor e um
// marcador no botão. Arraste para cima/baixo ou gire a roda do mouse.
component Knob inherits Rectangle {
    in-out property <float> value: 0.5;
    in property <color> ink;
    in property <color> accent;
    in property <bool> active: true;
    callback changed(float);
    property <float> start-value;
    property <length> start-y;
    width: 64px;
    height: 64px;
    opacity: root.active ? 1 : 0.4;
    // Anel em arco liso (trilho apagado + parte preenchida), de -135° a +135°.
    Path {
        width: root.width;
        height: root.height;
        viewbox-width: 64;
        viewbox-height: 64;
        stroke: root.ink.with-alpha(0.18);
        stroke-width: 4px;
        stroke-line-cap: round;
        MoveTo { x: 12.2; y: 51.8; }
        ArcTo { x: 51.8; y: 51.8; radius-x: 28; radius-y: 28; large-arc: true; sweep: true; }
    }
    if root.value > 0.005: Path {
        property <angle> a: -135deg + root.value * 270deg;
        width: root.width;
        height: root.height;
        viewbox-width: 64;
        viewbox-height: 64;
        stroke: root.accent;
        stroke-width: 4px;
        stroke-line-cap: round;
        MoveTo { x: 12.2; y: 51.8; }
        ArcTo {
            x: 32 + 28 * sin(a);
            y: 32 - 28 * cos(a);
            radius-x: 28;
            radius-y: 28;
            large-arc: root.value > 0.6667;
            sweep: true;
        }
    }
    Rectangle {
        x: 12px;
        y: 12px;
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: root.ink.with-alpha(knob-touch.has-hover ? 0.2 : 0.12);
        border-width: 1px;
        border-color: root.ink.with-alpha(0.28);
        property <angle> a: -135deg + root.value * 270deg;
        Rectangle {
            width: 5px;
            height: 5px;
            border-radius: 2.5px;
            background: root.ink;
            x: parent.width / 2 + 12px * sin(parent.a) - 2.5px;
            y: parent.height / 2 - 12px * cos(parent.a) - 2.5px;
        }
    }
    knob-touch := TouchArea {
        enabled: root.active;
        mouse-cursor: ns-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.start-value = root.value;
                root.start-y = self.mouse-y;
            }
        }
        moved => {
            if (self.pressed) {
                root.value = max(0, min(1, root.start-value + (root.start-y - self.mouse-y) / 150px));
                root.changed(root.value);
            }
        }
        scroll-event(e) => {
            root.value = max(0, min(1, root.value + (e.delta-y > 0 ? 0.05 : -0.05)));
            root.changed(root.value);
            accept
        }
    }
}

// Interruptor liga/desliga.
component Switch inherits Rectangle {
    in property <bool> on;
    in property <color> ink;
    in property <color> accent;
    callback toggled();
    width: 40px;
    height: 22px;
    border-radius: 11px;
    background: root.on ? root.accent : root.ink.with-alpha(0.25);
    animate background { duration: 180ms; }
    Rectangle {
        x: root.on ? parent.width - self.width - 3px : 3px;
        y: 3px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;
        animate x { duration: 180ms; easing: ease-out; }
    }
    TouchArea {
        clicked => { root.toggled(); }
    }
}

export struct AppItem {
    name: string,
    letter: string,
    icon: image,
    has-icon: bool,
}

// Logo do WhatsApp (balão verde com o telefone), em vetor.
component WhatsAppLogo inherits Rectangle {
    in property <length> size: 28px;
    width: size;
    height: size;
    Rectangle {
        x: parent.width * 0.1;
        y: parent.height * 0.1;
        width: parent.width * 0.8;
        height: parent.height * 0.8;
        border-radius: self.width / 2;
        background: #ffffff;
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: #25d366;
        commands: "M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z";
    }
}

// Envelope de e-mail, em vetor.
component MailIcon inherits Rectangle {
    in property <length> size: 28px;
    width: size;
    height: size;
    border-radius: self.width * 0.24;
    background: #4f8cff;
    Path {
        x: parent.width * 0.2;
        y: parent.height * 0.28;
        width: parent.width * 0.6;
        height: parent.height * 0.44;
        viewbox-width: 20;
        viewbox-height: 14;
        stroke: #ffffff;
        stroke-width: 1.6px;
        commands: "M1 1 H19 V13 H1 Z M1 1 L10 8 L19 1";
    }
}

component Glyph inherits Text {
    font-family: "Segoe MDL2 Assets";
    vertical-alignment: center;
    horizontal-alignment: center;
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <color> ink;
    in property <length> size: 13px;
    callback clicked();
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: touch.has-hover ? ink.with-alpha(0.14) : transparent;
    Glyph {
        text: icon;
        color: ink;
        font-size: size;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Chip inherits Rectangle {
    width: label.preferred-width + 24px;
    in property <string> text;
    in property <color> ink;
    in property <color> accent;
    callback clicked();
    height: 28px;
    border-radius: 14px;
    background: touch.has-hover ? accent.with-alpha(0.35) : ink.with-alpha(0.12);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        label := Text {
            text: root.text;
            color: ink;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component Island inherits Window {
    title: "Nocto";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 14px;
    min-width: 120px;
    min-height: 36px;
    max-width: 4000px;
    max-height: 4000px;

    // 0 pílula, 1 barra de comando, 2 calendário, 3 soltar arquivo
    in property <int> mode: 0;
    in property <color> glass: #0b2a44b3;
    in property <color> accent: #2bb4ff;
    in property <color> ink: #ffffff;

    in property <string> track;
    in property <bool> playing;
    in property <bool> has-track;
    in property <string> notice: "Nocto";

    in property <string> status;
    in property <bool> status-error;

    in property <string> month-label;
    in property <[DayCell]> days;
    in property <[Item]> items;
    in property <string> selected-label;
    in property <string> theme-label;

    in property <string> drop-name;

    // Página do painel (0 música, 1 calendário) e dados da música.
    in property <int> page: 0;
    // Falso ao abrir o painel: entra direto na página, sem deslizar.
    in property <bool> slide: true;
    in property <[WaMsg]> wa-msgs;
    in property <int> wa-unread;
    in property <[WaMsg]> mail-msgs;
    in property <int> mail-unread;
    // Aba da página de mensagens: 0 = WhatsApp, 1 = e-mail.
    in-out property <int> msg-tab: 0;
    // O aviso que está aparecendo é de e-mail?
    in property <bool> notify-mail;
    in property <string> song-title;
    in property <string> artist;
    in property <bool> spotify;
    in property <image> cover;
    in property <bool> has-cover;
    in property <float> progress;
    in property <string> pos-text: "0:00";
    in property <string> dur-text: "0:00";
    // A pílula mostra a música (true) ou o relógio (false).
    in property <bool> show-music;
    in property <string> clock: "00:00";
    in property <string> date-text;
    in property <string> compact-label;
    // Volume do Spotify (0–1) e se há sessão de áudio dele para controlar.
    in-out property <float> volume: 0.5;
    // Configurações.
    in property <[AppItem]> apps;
    in property <bool> hide-fullscreen: true;
    in property <string> hotkey-label;
    in property <string> compact-short;
    in property <string> settings-note;
    in property <bool> drop-target;
    // Aviso de mensagem do WhatsApp (modo 4).
    in property <string> notify-sender;
    in property <string> notify-text;
    in property <bool> whatsapp-on: true;
    in property <bool> whatsapp-preview: true;
    in property <bool> has-volume;

    callback submit(string);
    callback cancel();
    callback expand();
    callback collapse();
    callback play-pause();
    callback next-track();
    callback prev-track();
    callback go-page(int);
    callback cycle-compact();
    callback volume-changed(float);
    callback remove-app(string);
    callback toggle-fullscreen();
    callback cycle-hotkey();
    callback open-notified();
    callback voice();
    in property <bool> listening;
    callback open-messages(bool);
    callback msg-tab-changed();
    callback toggle-whatsapp();
    callback toggle-whatsapp-preview();
    callback prev-month();
    callback next-month();
    callback pick-day(string);
    callback add-item(string);
    callback toggle-item(int);
    callback remove-item(int);
    callback cycle-theme();
    callback convert(string);

    public function focus-input() {
        input.text = "";
        input.focus();
    }

    public function focus-item-input() {
        item-input.focus();
    }

    public function focus-panel() {
        cal.focus();
    }

    // Tamanho atual da ilha (o vidro é desenhado atrás pelo compositor do Windows, em glass.rs).
    in property <length> island-w: 230px;
    in property <length> island-h: 34px;

    // A janela é fixa e transparente; só a área da ilha tem conteúdo. O morph usa a mesma
    // curva e duração do vidro (glass.rs: MORPH_MS e a bézier com "quique").
    // Ao mudar, marca a janela inteira para ser redesenhada e copiada para a tela.
    // O Rust incrementa nos momentos em que o Windows pode descartar a imagem da janela
    // (clique, foco, mudança de área); sem isso, só a parte que mudou voltava e o resto
    // ficava branco.
    in property <int> repaint;
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: mod(root.repaint, 2) == 0 ? #00000000 : #00000001;
    }

    shell := Rectangle {
        x: (root.width - root.island-w) / 2;
        y: 0;
        width: root.island-w;
        height: root.island-h;
        clip: true;
        animate x, width, height { duration: 420ms; easing: cubic-bezier(0.25, 1.28, 0.32, 1); }

        // ───────── Pílula (compacta) ─────────
        Rectangle {
            visible: root.mode == 0;
            opacity: root.mode == 0 ? 1 : 0;
            animate opacity { delay: 140ms; duration: 220ms; }
            TouchArea {
                clicked => { root.expand(); }
            }
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 10px;
                alignment: stretch;
                // Ícone: logo do Spotify, nota musical (outro player) ou relógio.
                if root.show-music && root.spotify: SpotifyLogo {
                    size: 24px;
                    y: (parent.height - self.height) / 2;
                }
                if root.show-music && !root.spotify: Rectangle {
                    width: 22px;
                    height: 22px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 6px;
                    background: root.accent.with-alpha(0.9);
                    Glyph {
                        text: "\u{EC4F}";
                        color: #ffffff;
                        font-size: 11px;
                    }
                }
                if !root.show-music: Text {
                    text: root.clock;
                    color: root.ink;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Text {
                    text: root.show-music ? root.track : root.date-text;
                    color: root.show-music ? root.ink : root.ink.with-alpha(0.7);
                    font-size: 13px;
                    font-weight: root.show-music ? 600 : 400;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                // Ondinha do som, como na Dynamic Island (só anima enquanto toca).
                if root.show-music && root.playing: Rectangle {
                    width: 4 * 3px + 3 * 2px;
                    for i in 4: Rectangle {
                        x: i * 5px;
                        width: 3px;
                        height: 4px + 12px * abs(sin((animation-tick() / 1ms) * 0.45deg + i * 70deg));
                        y: (parent.height - self.height) / 2;
                        border-radius: 1.5px;
                        background: root.accent;
                    }
                }
                if root.show-music: IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: root.playing ? Icons.pause : Icons.play;
                    ink: root.ink;
                    clicked => { root.play-pause(); }
                }
                if root.show-music: IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.next;
                    ink: root.ink;
                    clicked => { root.next-track(); }
                }
            }
        }

        // ───────── Aviso do WhatsApp ─────────
        Rectangle {
            visible: root.mode == 4;
            opacity: root.mode == 4 ? 1 : 0;
            animate opacity { delay: 120ms; duration: 220ms; }
            TouchArea {
                clicked => { root.open-notified(); }
            }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 18px;
                spacing: 12px;
                if !root.notify-mail: WhatsAppLogo {
                    size: 30px;
                    y: (parent.height - self.height) / 2;
                }
                if root.notify-mail: MailIcon {
                    size: 30px;
                    y: (parent.height - self.height) / 2;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: root.notify-sender;
                        color: root.ink;
                        font-size: 14px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: root.notify-text;
                        color: root.ink.with-alpha(0.75);
                        font-size: 12px;
                        overflow: elide;
                    }
                }
            }
        }

        // ───────── Barra de comando ─────────
        bar := FocusScope {
            visible: root.mode == 1;
            enabled: root.mode == 1;
            opacity: root.mode == 1 ? 1 : 0;
            animate opacity { delay: 140ms; duration: 220ms; }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.cancel();
                    return accept;
                }
                reject
            }
            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 12px;
                    height: 44px;
                    Glyph {
                        text: Icons.search;
                        color: root.ink.with-alpha(0.7);
                        font-size: 16px;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        Text {
                            x: 0;
                            width: parent.width;
                            visible: input.text == "";
                            text: root.listening ? "Ouvindo… fale o comando" : "abre spotify · toca <música> · agenda · pausa";
                            color: root.ink.with-alpha(0.4);
                            font-size: 17px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        input := TextInput {
                            width: parent.width;
                            color: root.ink;
                            selection-background-color: root.accent.with-alpha(0.5);
                            font-size: 17px;
                            vertical-alignment: center;
                            single-line: true;
                            accepted => { root.submit(self.text); }
                        }
                    }
                    // Microfone: clique e fale o comando ("toca only day", "abre brave"…).
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 16px;
                        background: root.listening ? root.accent : root.ink.with-alpha(mic.has-hover ? 0.16 : 0.08);
                        animate background { duration: 200ms; }
                        // Anel pulsando enquanto ouve.
                        if root.listening: Rectangle {
                            property <float> t: mod(animation-tick() / 1100ms, 1);
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: parent.width * (1 + 0.6 * self.t);
                            height: self.width;
                            border-radius: self.width / 2;
                            border-width: 2px;
                            border-color: root.accent.with-alpha(1 - self.t);
                        }
                        Path {
                            x: 9px;
                            y: 7px;
                            width: 14px;
                            height: 18px;
                            viewbox-width: 14;
                            viewbox-height: 18;
                            stroke: root.listening ? #ffffff : root.ink.with-alpha(0.8);
                            stroke-width: 1.6px;
                            commands: "M4.5 3.5 A2.5 2.5 0 0 1 9.5 3.5 V8.5 A2.5 2.5 0 0 1 4.5 8.5 Z M1.5 8 A5.5 5.5 0 0 0 12.5 8 M7 13.5 V17 M4 17 H10";
                        }
                        mic := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.voice(); }
                        }
                    }
                }
                if root.status != "": Text {
                    text: root.status;
                    color: root.status-error ? #ffb4a8 : root.ink.with-alpha(0.8);
                    font-size: 13px;
                    overflow: elide;
                    height: 26px;
                    vertical-alignment: center;
                }
            }
        }

        // ───────── Calendário ─────────
        // ───────── Painel com páginas: música e calendário ─────────
        cal := FocusScope {
            visible: root.mode == 2;
            enabled: root.mode == 2;
            opacity: root.mode == 2 ? 1 : 0;
            animate opacity { delay: 160ms; duration: 240ms; }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.collapse();
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    root.go-page(max(0, root.page - 1));
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    root.go-page(min(3, root.page + 1));
                    return accept;
                }
                reject
            }
            // Arrastar para o lado ou girar a roda do mouse troca de página.
            swipe := TouchArea {
                property <length> start-x;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        self.start-x = self.mouse-x;
                    }
                    if (e.kind == PointerEventKind.up) {
                        if (self.mouse-x - self.start-x < -60px) {
                            root.go-page(min(3, root.page + 1));
                        } else if (self.mouse-x - self.start-x > 60px) {
                            root.go-page(max(0, root.page - 1));
                        }
                    }
                }
                scroll-event(e) => {
                    if (e.delta-y < 0 || e.delta-x < 0) {
                        root.go-page(min(3, root.page + 1));
                    } else if (e.delta-y > 0 || e.delta-x > 0) {
                        root.go-page(max(0, root.page - 1));
                    }
                    accept
                }
                Rectangle {
                    x: -root.page * parent.width;
                    y: 0;
                    width: parent.width * 4;
                    height: parent.height;
                    animate x { duration: root.slide ? 380ms : 0ms; easing: cubic-bezier(0.25, 1.1, 0.32, 1); }
                    // Página 1: música (capa, nome, artista, tempo e controles).
                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width / 4;
                        height: 214px;
                        HorizontalLayout {
                            padding: 22px;
                            padding-top: 34px;
                            spacing: 20px;
                            Rectangle {
                                width: 150px;
                                height: 150px;
                                border-radius: 18px;
                                clip: true;
                                background: root.accent.with-alpha(0.35);
                                if root.has-cover: Image {
                                    width: parent.width;
                                    height: parent.height;
                                    source: root.cover;
                                    image-fit: ImageFit.cover;
                                }
                                if !root.has-cover: Glyph {
                                    text: "\u{EC4F}";
                                    color: root.ink.with-alpha(0.8);
                                    font-size: 46px;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    height: 30px;
                                    Text {
                                        text: root.has-track ? root.song-title : "Nada tocando";
                                        color: root.ink;
                                        font-size: 21px;
                                        font-weight: 600;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    if root.spotify: SpotifyLogo {
                                        size: 28px;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                                Text {
                                    text: root.has-track ? root.artist : "Abra o Spotify ou outro player";
                                    color: root.ink.with-alpha(0.65);
                                    font-size: 14px;
                                    overflow: elide;
                                }
                                Rectangle {
                                    vertical-stretch: 1;
                                }
                                Rectangle {
                                    height: 6px;
                                    border-radius: 3px;
                                    background: root.ink.with-alpha(0.2);
                                    Rectangle {
                                        x: 0;
                                        width: parent.width * root.progress;
                                        height: parent.height;
                                        border-radius: 3px;
                                        background: root.ink;
                                    }
                                }
                                HorizontalLayout {
                                    height: 18px;
                                    Text {
                                        text: root.pos-text;
                                        color: root.ink.with-alpha(0.6);
                                        font-size: 11px;
                                    }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: root.dur-text;
                                        color: root.ink.with-alpha(0.6);
                                        font-size: 11px;
                                    }
                                }
                                HorizontalLayout {
                                    height: 44px;
                                    alignment: center;
                                    spacing: 18px;
                                    IconButton {
                                        y: (parent.height - self.height) / 2;
                                        icon: Icons.prev;
                                        ink: root.ink;
                                        size: 15px;
                                        clicked => { root.prev-track(); }
                                    }
                                    Rectangle {
                                        width: 44px;
                                        height: 44px;
                                        border-radius: 22px;
                                        background: play-touch.has-hover ? root.ink : root.ink.with-alpha(0.92);
                                        Glyph {
                                            text: root.playing ? Icons.pause : Icons.play;
                                            color: #000000;
                                            font-size: 16px;
                                        }
                                        play-touch := TouchArea {
                                            clicked => { root.play-pause(); }
                                        }
                                    }
                                    IconButton {
                                        y: (parent.height - self.height) / 2;
                                        icon: Icons.next;
                                        ink: root.ink;
                                        size: 15px;
                                        clicked => { root.next-track(); }
                                    }
                                }
                            }
                            VerticalLayout {
                                width: 72px;
                                alignment: center;
                                spacing: 4px;
                                Knob {
                                    x: (parent.width - self.width) / 2;
                                    value <=> root.volume;
                                    active: root.has-volume;
                                    ink: root.ink;
                                    accent: root.accent;
                                    changed(v) => { root.volume-changed(v); }
                                }
                                Text {
                                    text: root.has-volume ? "Vol " + round(root.volume * 100) + "%" : "Vol —";
                                    color: root.ink.with-alpha(0.7);
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                        Chip {
                            x: parent.width - self.width - 18px;
                            y: parent.height - self.height - 16px;
                            text: root.compact-label;
                            ink: root.ink;
                            accent: root.accent;
                            clicked => { root.cycle-compact(); }
                        }
                    }
                    // Página 2: calendário.
                    Rectangle {
                        x: parent.width / 4;
                        y: 0;
                        width: parent.width / 4;
                        height: 340px;
                    HorizontalLayout {
                        padding: 18px;
                        padding-top: 30px;
                        spacing: 18px;

                        // Grade do mês
                        VerticalLayout {
                            width: 300px;
                            spacing: 6px;
                            HorizontalLayout {
                                height: 30px;
                                Text {
                                    text: root.month-label;
                                    color: root.ink;
                                    font-size: 17px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                IconButton {
                                    icon: Icons.left;
                                    ink: root.ink;
                                    size: 11px;
                                    clicked => { root.prev-month(); }
                                }
                                IconButton {
                                    icon: Icons.right;
                                    ink: root.ink;
                                    size: 11px;
                                    clicked => { root.next-month(); }
                                }
                            }
                            HorizontalLayout {
                                height: 18px;
                                for w in ["D", "S", "T", "Q", "Q", "S", "S"]: Text {
                                    width: 300px / 7;
                                    text: w;
                                    color: root.ink.with-alpha(0.5);
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                }
                            }
                            Rectangle {
                                height: 6 * 38px;
                                for d[i] in root.days: Rectangle {
                                    x: mod(i, 7) * (300px / 7);
                                    y: floor(i / 7) * 38px;
                                    width: 300px / 7;
                                    height: 38px;
                                    Rectangle {
                                        width: 32px;
                                        height: 32px;
                                        border-radius: 16px;
                                        background: d.selected ? root.accent : (cell.has-hover ? root.ink.with-alpha(0.12) : transparent);
                                        border-width: d.today && !d.selected ? 1px : 0px;
                                        border-color: root.accent;
                                    }
                                    Text {
                                        text: d.label;
                                        color: d.in-month ? root.ink : root.ink.with-alpha(0.3);
                                        font-size: 13px;
                                        font-weight: d.today ? 700 : 400;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    if d.marked: Rectangle {
                                        y: parent.height - 6px;
                                        width: 4px;
                                        height: 4px;
                                        border-radius: 2px;
                                        background: d.selected ? root.ink : root.accent;
                                    }
                                    cell := TouchArea {
                                        clicked => { root.pick-day(d.iso); }
                                    }
                                }
                            }
                        }

                        // Itens do dia
                        VerticalLayout {
                            spacing: 8px;
                            HorizontalLayout {
                                height: 30px;
                                Text {
                                    text: root.selected-label;
                                    color: root.ink;
                                    font-size: 15px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Chip {
                                    text: root.theme-label;
                                    ink: root.ink;
                                    accent: root.accent;
                                    clicked => { root.cycle-theme(); }
                                }
                            }
                            Flickable {
                                vertical-stretch: 1;
                                content-height: max(self.height, root.items.length * 36px);
                                for it[i] in root.items: Rectangle {
                                    y: i * 36px;
                                    height: 34px;
                                    width: parent.width;
                                    border-radius: 8px;
                                    background: row.has-hover ? root.ink.with-alpha(0.08) : transparent;
                                    row := TouchArea {
                                        clicked => { root.toggle-item(i); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        spacing: 8px;
                                        Rectangle {
                                            width: 18px;
                                            height: 18px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 9px;
                                            border-width: 1.5px;
                                            border-color: root.accent;
                                            background: it.done ? root.accent : transparent;
                                            if it.done: Glyph {
                                                text: Icons.check;
                                                color: root.glass.with-alpha(1);
                                                font-size: 10px;
                                            }
                                        }
                                        if it.time != "": Text {
                                            text: it.time;
                                            color: root.accent;
                                            font-size: 13px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: it.title;
                                            color: it.done ? root.ink.with-alpha(0.45) : root.ink;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        IconButton {
                                            y: (parent.height - self.height) / 2;
                                            icon: Icons.close;
                                            ink: root.ink.with-alpha(0.6);
                                            size: 10px;
                                            clicked => { root.remove-item(i); }
                                        }
                                    }
                                }
                                if root.items.length == 0: Text {
                                    y: 8px;
                                    text: "Nada marcado.";
                                    color: root.ink.with-alpha(0.5);
                                    font-size: 13px;
                                }
                            }
                            Rectangle {
                                height: 36px;
                                border-radius: 8px;
                                background: root.ink.with-alpha(0.1);
                                Text {
                                    x: 12px;
                                    visible: item-input.text == "";
                                    text: "14:00 reunião · Enter para adicionar";
                                    color: root.ink.with-alpha(0.4);
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    height: parent.height;
                                }
                                item-input := TextInput {
                                    x: 12px;
                                    width: parent.width - 24px;
                                    height: parent.height;
                                    color: root.ink;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    single-line: true;
                                    accepted => {
                                        root.add-item(self.text);
                                        self.text = "";
                                    }
                                }
                            }
                        }
                    }
                    }
                    // Página 3: mensagens (WhatsApp e e-mail, trocando pela aba de cima).
                    Rectangle {
                        x: parent.width * 2 / 4;
                        y: 0;
                        width: parent.width / 4;
                        height: 340px;
                        VerticalLayout {
                            padding: 22px;
                            padding-top: 30px;
                            spacing: 10px;
                            HorizontalLayout {
                                spacing: 12px;
                                height: 30px;
                                Text { text: "Mensagens"; color: root.ink; font-size: 17px; font-weight: 600; vertical-alignment: center; }
                                // Seletor WhatsApp | E-mail.
                                Rectangle {
                                    width: 230px;
                                    border-radius: 15px;
                                    background: root.ink.with-alpha(0.08);
                                    Rectangle {
                                        x: 3px + root.msg-tab * (parent.width - 6px) / 2;
                                        y: 3px;
                                        width: (parent.width - 6px) / 2;
                                        height: parent.height - 6px;
                                        border-radius: 12px;
                                        background: root.ink.with-alpha(0.16);
                                        animate x { duration: 260ms; easing: cubic-bezier(0.25, 1.1, 0.32, 1); }
                                    }
                                    for tab[i] in [{ label: "WhatsApp", unread: root.wa-unread }, { label: "E-mail", unread: root.mail-unread }]: TouchArea {
                                        x: i * parent.width / 2;
                                        width: parent.width / 2;
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.msg-tab = i;
                                            root.msg-tab-changed();
                                        }
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;
                                            if i == 0: WhatsAppLogo { size: 16px; y: (parent.height - self.height) / 2; }
                                            if i == 1: MailIcon { size: 16px; y: (parent.height - self.height) / 2; }
                                            Text { text: tab.label; color: root.ink.with-alpha(root.msg-tab == i ? 1 : 0.65); font-size: 13px; vertical-alignment: center; }
                                            if tab.unread > 0 && root.msg-tab != i: Rectangle {
                                                y: (parent.height - 7px) / 2;
                                                width: 7px;
                                                height: 7px;
                                                border-radius: 3.5px;
                                                background: i == 0 ? #25d366 : #4f8cff;
                                            }
                                        }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                TouchArea {
                                    width: 70px;
                                    mouse-cursor: pointer;
                                    clicked => { root.open-messages(root.msg-tab == 1); }
                                    Text { text: "Abrir ›"; color: root.msg-tab == 1 ? #4f8cff : #25d366; font-size: 13px; vertical-alignment: center; horizontal-alignment: right; }
                                }
                            }
                            if (root.msg-tab == 0 ? root.wa-msgs : root.mail-msgs).length == 0: Text {
                                text: root.msg-tab == 0 ? "Nenhuma mensagem nova." : "Nenhum e-mail novo. (Chegam pelos avisos do Outlook ou do Gmail no navegador.)";
                                color: root.ink.with-alpha(0.55);
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                            for m in (root.msg-tab == 0 ? root.wa-msgs : root.mail-msgs): Rectangle {
                                height: 46px;
                                border-radius: 12px;
                                background: root.ink.with-alpha(0.07);
                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Text { text: m.sender; color: root.ink; font-size: 13px; font-weight: 600; overflow: elide; }
                                        Text { text: m.text; color: root.ink.with-alpha(0.75); font-size: 12px; overflow: elide; }
                                    }
                                    Text { text: m.time; color: root.ink.with-alpha(0.5); font-size: 11px; vertical-alignment: center; }
                                }
                            }
                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                    // Página 4: configurações e apps do "abre".
                    Rectangle {
                        x: parent.width * 3 / 4;
                        y: 0;
                        width: parent.width / 4;
                        height: 380px;
                        HorizontalLayout {
                            padding: 20px;
                            padding-top: 32px;
                            spacing: 22px;
                            VerticalLayout {
                                width: 290px;
                                spacing: 10px;
                                Text {
                                    text: "Configurações";
                                    color: root.ink;
                                    font-size: 17px;
                                    font-weight: 600;
                                }
                                HorizontalLayout {
                                    height: 30px;
                                    Text { text: "Tema"; color: root.ink.with-alpha(0.85); font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                                    Chip { text: root.theme-label; ink: root.ink; accent: root.accent; clicked => { root.cycle-theme(); } }
                                }
                                HorizontalLayout {
                                    height: 30px;
                                    Text { text: "Pílula mostra"; color: root.ink.with-alpha(0.85); font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                                    Chip { text: root.compact-short; ink: root.ink; accent: root.accent; clicked => { root.cycle-compact(); } }
                                }
                                HorizontalLayout {
                                    height: 30px;
                                    Text { text: "Esconder em jogos (tela cheia)"; color: root.ink.with-alpha(0.85); font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                                    Switch { y: 4px; on: root.hide-fullscreen; ink: root.ink; accent: root.accent; toggled => { root.toggle-fullscreen(); } }
                                }
                                HorizontalLayout {
                                    height: 30px;
                                    Text { text: "Avisos de mensagens e e-mail"; color: root.ink.with-alpha(0.85); font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                                    Switch { y: 4px; on: root.whatsapp-on; ink: root.ink; accent: root.accent; toggled => { root.toggle-whatsapp(); } }
                                }
                                HorizontalLayout {
                                    height: 30px;
                                    Text { text: "Mostrar texto das mensagens"; color: root.ink.with-alpha(0.85); font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                                    Switch { y: 4px; on: root.whatsapp-preview; ink: root.ink; accent: root.accent; toggled => { root.toggle-whatsapp-preview(); } }
                                }
                                HorizontalLayout {
                                    height: 30px;
                                    Text { text: "Atalho"; color: root.ink.with-alpha(0.85); font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                                    Chip { text: root.hotkey-label; ink: root.ink; accent: root.accent; clicked => { root.cycle-hotkey(); } }
                                }
                                Text {
                                    text: root.settings-note;
                                    color: root.accent;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                            VerticalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Apps do “abre”";
                                    color: root.ink;
                                    font-size: 15px;
                                    font-weight: 600;
                                }
                                Rectangle {
                                    height: 50px;
                                    border-radius: 12px;
                                    border-width: 1px;
                                    border-color: root.drop-target ? root.accent : root.ink.with-alpha(0.3);
                                    background: root.drop-target ? root.accent.with-alpha(0.25) : root.ink.with-alpha(0.06);
                                    animate background, border-color { duration: 200ms; }
                                    Text {
                                        text: root.drop-target ? "Solte para adicionar" : "Arraste um app ou atalho até a ilha";
                                        color: root.ink.with-alpha(0.8);
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Flickable {
                                    vertical-stretch: 1;
                                    content-height: max(self.height, root.apps.length * 32px);
                                    for app[i] in root.apps: Rectangle {
                                        y: i * 32px;
                                        width: parent.width;
                                        height: 30px;
                                        border-radius: 8px;
                                        background: app-row.has-hover ? root.ink.with-alpha(0.08) : transparent;
                                        app-row := TouchArea { }
                                        HorizontalLayout {
                                            padding-left: 4px;
                                            spacing: 8px;
                                            if app.has-icon: Image {
                                                width: 22px;
                                                height: 22px;
                                                y: (parent.height - self.height) / 2;
                                                source: app.icon;
                                                image-fit: contain;
                                            }
                                            if !app.has-icon: Rectangle {
                                                width: 22px;
                                                height: 22px;
                                                y: (parent.height - self.height) / 2;
                                                border-radius: 6px;
                                                background: root.accent.with-alpha(0.8);
                                                Text {
                                                    text: app.letter;
                                                    color: #ffffff;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            Text {
                                                text: app.name;
                                                color: root.ink;
                                                font-size: 13px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                            IconButton {
                                                y: (parent.height - self.height) / 2;
                                                icon: Icons.close;
                                                ink: root.ink.with-alpha(0.6);
                                                size: 9px;
                                                clicked => { root.remove-app(app.name); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // Bolinhas: uma por página.
            HorizontalLayout {
                y: 10px;
                height: 8px;
                alignment: center;
                spacing: 8px;
                for i in 4: Rectangle {
                    width: root.page == i ? 18px : 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    // A bolinha do WhatsApp fica verde quando há mensagem não lida.
                    background: i == 2 && root.wa-unread + root.mail-unread > 0 && root.page != 2 ? (root.wa-unread > 0 ? #25d366 : #4f8cff) : root.page == i ? root.ink : root.ink.with-alpha(0.35);
                    animate width, background { duration: 250ms; }
                    TouchArea {
                        clicked => { root.go-page(i); }
                    }
                }
            }
        }

        // ───────── Soltar arquivo ─────────
        if root.mode == 3: FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.collapse();
                    return accept;
                }
                reject
            }
            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 10px;
                    Glyph {
                        text: Icons.image;
                        color: root.accent;
                        font-size: 18px;
                    }
                    Text {
                        text: root.drop-name == "" ? "Solte a imagem aqui" : root.drop-name;
                        color: root.ink;
                        font-size: 15px;
                        font-weight: 600;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    IconButton {
                        icon: Icons.close;
                        ink: root.ink;
                        size: 10px;
                        clicked => { root.collapse(); }
                    }
                }
                if root.drop-name != "": HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Chip { text: "PNG"; ink: root.ink; accent: root.accent; clicked => { root.convert("png"); } }
                    Chip { text: "JPEG"; ink: root.ink; accent: root.accent; clicked => { root.convert("jpeg"); } }
                    Chip { text: "WebP"; ink: root.ink; accent: root.accent; clicked => { root.convert("webp"); } }
                    Chip { text: "Remover fundo"; ink: root.ink; accent: root.accent; clicked => { root.convert("nobg"); } }
                }
                Text {
                    text: root.status;
                    color: root.status-error ? #ffb4a8 : root.ink.with-alpha(0.8);
                    font-size: 12px;
                    overflow: elide;
                }
            }
        }
    }
}
